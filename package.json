{
  "name": "moopit-bejeweled",
  "private": true,
  "version": "0.2.0",
  "codename": "puddles",
  "type": "module",
  "description": "GEMFALL — an original Bejeweled-like match-3 game (Phaser 4 + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "selftest": "tools/selftest.sh",
    "playtest": "node tools/playtest.mjs",
    "visual": "python3 tools/analyze-shots.py poc",
    "scaling": "node tools/probe-scale.mjs",
    "pwa": "node tools/pwa-check.mjs",
    "poc": "tools/poc.sh",
    "gates": "tools/gates.sh",
    "ship": "tools/ship.sh"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
